---
whiskers:
  version: "2.2.0"
  matrix:
    - flavor
    - accent
  filename: "flavors/{{ flavor.identifier }}/catppuccin-{{ flavor.identifier }}-{{ accent }}.yazi/flavor.toml"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---

{%- set accent = flavor.colors[accent] -%}

#:schema https://yazi-rs.github.io/schemas/theme.json
# vim:fileencoding=utf-8:foldmethod=marker

[app]
overall = { bg = "{{ base.hex }}" }

[mgr]
cwd = { fg = "{{ teal.hex }}" }

# Find
find_keyword  = { fg = "{{ yellow.hex }}", italic = true }
find_position = { fg = "{{ pink.hex }}", bg = "reset", italic = true }

# Symlink
symlink_target = { italic = true }

# Marker
marker_copied   = { fg = "{{ green.hex }}", bg = "{{ green.hex }}" }
marker_cut      = { fg = "{{ red.hex }}", bg = "{{ red.hex }}" }
marker_marked   = { fg = "{{ teal.hex }}", bg = "{{ teal.hex }}" }
marker_selected = { fg = "{{ accent.hex }}", bg = "{{ accent.hex }}" }

# Count
count_copied   = { fg = "{{ base.hex }}", bg = "{{ green.hex }}" }
count_cut      = { fg = "{{ base.hex }}", bg = "{{ red.hex }}" }
count_selected = { fg = "{{ base.hex }}", bg = "{{ accent.hex }}" }

# Border
border_symbol = "│"
border_style  = { fg = "{{ overlay1.hex }}" }

[tabs]
active   = { fg = "{{ base.hex }}", bg = "{{ text.hex }}", bold = true }
inactive = { fg = "{{ text.hex }}", bg = "{{ surface1.hex }}" }

# Separator
sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

[mode]
normal_main = { fg = "{{ base.hex }}", bg = "{{ accent.hex }}", bold = true }
normal_alt  = { fg = "{{ accent.hex }}", bg = "{{ surface0.hex }}"}

# Select mode
select_main = { fg = "{{ base.hex }}", bg = "{{ green.hex }}", bold = true }
select_alt  = { fg = "{{ green.hex }}", bg = "{{ surface0.hex }}"}

# Unset mode
unset_main  = { fg = "{{ base.hex }}", bg = "{{ flamingo.hex }}", bold = true }
unset_alt   = { fg = "{{ flamingo.hex }}", bg = "{{ surface0.hex }}"}

[indicator]
parent = { fg = "{{ base.hex }}", bg = "{{ text.hex }}" }
current = { fg = "{{ base.hex }}", bg = "{{ accent.hex }}" }
preview = { fg = "{{ base.hex }}", bg = "{{ text.hex }}" }
padding = { open = "", close = "" }

[status]
overall = {}
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

# Permissions
perm_type  = { fg = "{{ blue.hex }}" }
perm_read  = { fg = "{{ yellow.hex }}" }
perm_write = { fg = "{{ red.hex }}" }
perm_exec  = { fg = "{{ green.hex }}" }
perm_sep   = { fg = "{{ overlay1.hex }}" }

# Progress
progress_label  = { fg = "#ffffff", bold = true }
progress_normal = { fg = "{{ green.hex }}", bg = "{{ surface1.hex }}" }
progress_error  = { fg = "{{ yellow.hex }}", bg = "{{ red.hex }}" }

[which]
cols = 3
mask            = { bg = "{{ surface0.hex }}" }
cand            = { fg = "{{ teal.hex }}" }
rest            = { fg = "{{ overlay2.hex }}" }
desc            = { fg = "{{ pink.hex }}" }
separator       = "  "
separator_style = { fg = "{{ surface2.hex }}" }

[confirm]
border     = { fg = "{{ accent.hex }}" }
title      = { fg = "{{ accent.hex }}" }
body       = {}
list       = {}
btn_yes    = { reversed = true }
btn_no     = {}
btn_labels = ["  [Y]es  ", "  (N)o  "]

[spot]
border = { fg = "{{ accent.hex }}" }
title  = { fg = "{{ accent.hex }}" }

# Table
tbl_cell = { fg = "{{ accent.hex }}", reversed = true }
tbl_col = { bold = true }

[notify]
title_info  = { fg = "{{ teal.hex }}" }
title_warn  = { fg = "{{ yellow.hex }}" }
title_error = { fg = "{{ red.hex }}" }

# Icons
icon_info = ""
icon_warn = ""
icon_error = ""

[pick]
border   = { fg = "{{ accent.hex }}" }
active   = { fg = "{{ pink.hex }}" }
inactive = {}

[input]
border   = { fg = "{{ accent.hex }}" }
title    = {}
value    = {}
selected = { reversed = true }

[cmp]
border = { fg = "{{ accent.hex }}" }
active = { reversed = true }
inactive = {}

# Icons
icon_file = ""
icon_folder = ""
icon_command = ""

[tasks]
border  = { fg = "{{ accent.hex }}" }
title   = {}
hovered = { fg = "{{ pink.hex }}", bold = true }

[help]
on      = { fg = "{{ teal.hex }}" }
run     = { fg = "{{ pink.hex }}" }
desc    = { fg = "{{ overlay2.hex }}" }
hovered = { bg = "{{ surface2.hex }}", bold = true }
footer  = { fg = "{{ text.hex }}", bg = "{{ surface1.hex }}" }

[filetype]
rules = [
  # Image
	{ mime = "image/*", fg = "{{ teal.hex }}" },

	# Media
	{ mime = "{audio,video}/*", fg = "{{ yellow.hex }}" },

	# Archive
  { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{ pink.hex }}" },

	# Documents
	{ mime = "application/{pdf,doc,rtf}", fg = "{{ green.hex }}" },

	# Virtual file system
	{ mime = "vfs/{absent,stale}", fg = "{{ surface1.hex }}" },

	# Special file
	{ url = "*", is = "orphan", bg = "{{ red.hex }}" },
	{ url = "*", is = "exec"  , fg = "{{ green.hex }}" },

	# Dummy file
	{ url = "*", is = "dummy", bg = "{{ red.hex }}" },
	{ url = "*/", is = "dummy", bg = "{{ red.hex }}" },

	# Fallback
	{ url = "*/", fg = "{{ accent.hex }}" }
]

[icon]
globs = []
dirs = [
  { name = ".config", text = "", fg = "{{ pink.hex }}" },
  { name = ".git", text = "", fg = "{{ teal.hex }}" },
  { name = ".github", text = "", fg = "{{ blue.hex }}" },
  { name = ".npm", text = "", fg = "{{ blue.hex }}" },
  { name = "Desktop", text = "", fg = "{{ teal.hex }}" },
  { name = "Development", text = "", fg = "{{ teal.hex }}" },
  { name = "Documents", text = "", fg = "{{ teal.hex }}" },
  { name = "Downloads", text = "", fg = "{{ teal.hex }}" },
  { name = "Library", text = "", fg = "{{ teal.hex }}" },
  { name = "Movies", text = "", fg = "{{ teal.hex }}" },
  { name = "Music", text = "", fg = "{{ teal.hex }}" },
  { name = "Pictures", text = "", fg = "{{ teal.hex }}" },
  { name = "Public", text = "", fg = "{{ teal.hex }}" },
  { name = "Videos", text = "", fg = "{{ teal.hex }}" },
]
conds = [
  # Special files
  { if = "orphan", text = "", fg = "{{ text.hex }}" },
  { if = "link", text = "", fg = "{{ overlay1.hex }}" },
  { if = "block", text = "", fg = "{{ flamingo.hex }}" },
  { if = "char", text = "", fg = "{{ flamingo.hex }}" },
  { if = "fifo", text = "", fg = "{{ flamingo.hex }}" },
  { if = "sock", text = "", fg = "{{ flamingo.hex }}" },
  { if = "sticky", text = "", fg = "{{ flamingo.hex }}" },
  { if = "dummy", text = "", fg = "{{ red.hex }}" },

  # Fallback
  { if = "dir & hovered", text = "", fg = "{{ accent.hex }}" },
  { if = "dir", text = "", fg = "{{ accent.hex }}" },
  { if = "exec", text = "", fg = "{{ green.hex }}" },
  { if = "!dir", text = "", fg = "{{ text.hex }}" },
]
